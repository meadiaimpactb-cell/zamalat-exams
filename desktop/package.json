{
  "name": "pfellowships-secure-exam",
  "productName": "الاختبار الآمن — الزمالات المهنية",
  "version": "1.0.0",
  "description": "Secure lockdown desktop client for the Professional Fellowships Exam Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "sa.pfellowships.secureexam",
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "shortcutName": "الاختبار الآمن"
    }
  }
}
